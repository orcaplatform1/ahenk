# Uygulama
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# Veritabanı (PostgreSQL)
DATABASE_URL=postgresql://ahenk:ahenk_password@localhost:5432/ahenk_db

# JWT
JWT_SECRET=degistir_bu_degeri_production_da
JWT_REFRESH_SECRET=bunu_da_degistir_production_da
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis (OTP & kuyruk)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (S3-uyumlu nesne depolama)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=ahenk-kyc
R2_ACCESS_KEY_ID=          # R2 API Token'dan
R2_SECRET_ACCESS_KEY=      # R2 API Token'dan

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@ahenk.tr
SMTP_PASS=

# WhatsApp Business API (Meta Cloud)
# Üretim için gerekli — dev modda sadece console.log yazar
WHATSAPP_PHONE_NUMBER_ID=          # Meta Developer Console'dan al
WHATSAPP_ACCESS_TOKEN=             # System User Token (uzun ömürlü)
WHATSAPP_OTP_TEMPLATE=ahenk_otp   # Onaylı şablon adı

# Superadmin (seed için)
SUPERADMIN_EMAIL=admin@ahenk.tr
SUPERADMIN_PASSWORD=Ahenk2024!

# Port
PORT=4000

# Firebase Cloud Messaging (FCM) — push bildirimler için
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=       # Service account JSON'dan — \n ile satır sonları

# iyzico Ödeme (sandbox: https://sandbox.iyzipay.com, prod: https://api.iyzipay.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:3000/odeme/callback

# Domain (onay bekliyor)
# DOMAIN=ahenk.tr
