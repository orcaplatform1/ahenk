# Uygulama
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Veritabanı (PostgreSQL)
DATABASE_URL=postgresql://ahenk:ahenk_password@localhost:5432/ahenk_db

# JWT
JWT_SECRET=degistir_bu_degeri_production_da
JWT_REFRESH_SECRET=bunu_da_degistir_production_da
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis (OTP & kuyruk)
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@ahenk.tr
SMTP_PASS=

# WhatsApp Business API (Meta Cloud)
# Üretim için gerekli — dev modda sadece console.log yazar
WHATSAPP_PHONE_NUMBER_ID=          # Meta Developer Console'dan al
WHATSAPP_ACCESS_TOKEN=             # System User Token (uzun ömürlü)
WHATSAPP_OTP_TEMPLATE=ahenk_otp   # Onaylı şablon adı

# Superadmin (seed için)
SUPERADMIN_EMAIL=admin@ahenk.tr
SUPERADMIN_PASSWORD=Ahenk2024!

# Port
PORT=4000

# Firebase Cloud Messaging (FCM) — push bildirimler için
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=       # Service account JSON'dan — \n ile satır sonları

# iyzico Ödeme (sandbox: https://sandbox-api.iyzipay.com, prod: https://api.iyzipay.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:4000/api/v1/payment/callback
# Abonelik webhook imzası için iyzico üye işyeri numarası (fiyat planları SUPERADMIN fiyat sayfasından otomatik açılır)
IYZICO_MERCHANT_ID=

# Claude API (masa AI raporu) — lansmana yakın eklenecek
CLAUDE_API_KEY=

# Domain (onay bekliyor)
# DOMAIN=ahenk.tr

# TC kimlik no şifreleme anahtarı (AES-256, 64 hex): openssl rand -hex 32
IDENTITY_ENC_KEY=
