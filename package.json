{
  "name": "ahenk",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev:web": "pnpm --filter @ahenk/web dev",
    "dev:mobile": "pnpm --filter @ahenk/mobile start",
    "dev:backend": "pnpm --filter @ahenk/backend start:dev",
    "build:web": "pnpm --filter @ahenk/web build",
    "build:backend": "pnpm --filter @ahenk/backend build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
