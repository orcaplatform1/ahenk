    "android": {
      "package": "co.ahenk.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ahenk.co"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 4
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Hesap güvenliğiniz için Face ID kullanılır."
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/start_logo.jpg",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kimlik doğrulama için kamera gereklidir.",
          "microphonePermission": "Canlılık videosu kaydı için mikrofon gereklidir.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Rehberindeki numaraları engelleme listesine eklemek için kullanılır."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Acil yardım talebinde bulunduğunda konumun emniyet birimleriyle paylaşılır ve ekibimiz tarafından takip edilir.",
          "locationAlwaysAndWhenInUsePermission": "Acil yardım talebinde bulunduğunda, uygulama kapansa bile konumun talep çözülene kadar emniyet birimleriyle paylaşılır ve ekibimiz tarafından takip edilir.",
          "locationAlwaysPermission": "Acil yardım talebinde bulunduğunda, uygulama kapansa bile konumun talep çözülene kadar emniyet birimleriyle paylaşılır ve ekibimiz tarafından takip edilir.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      "expo-iap",
      "./plugins/withAutofillHighlight",
      "./plugins/withAndroidRelease",
      "expo-localization"
    ],
    "experiments": {
